# EditorConfig 帮助不同编辑器保持一致格式。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.ps1]
charset = utf-8-bom
end_of_line = lf
indent_size = 4

[*.md]
trim_trailing_whitespace = false
